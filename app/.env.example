# Server-side only. Never prefix with VITE_ (that would ship it to the browser).
# Local dev: copy to .env.local (gitignored) and fill in. Vercel: Project settings > Environment Variables.
ANTHROPIC_API_KEY=
# Optional model overrides (see docs/AI.md, cost notes).
# ANTHROPIC_MATCH_MODEL=
# ANTHROPIC_DRAFT_MODEL=
# Optional: point the client at an API on another origin.
# VITE_API_BASE=

# Client switch: the app only calls /api when this is true at build time. Leave unset for the public demo.
# VITE_AI_ENABLED=true
